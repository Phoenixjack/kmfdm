{
  "policy_schema_version": 1,
  "id": "minimal-library-policy",
  "name": "Minimal Library Policy",
  "description": "Basic KiCad library metadata checks with only built-in fields.",
  "enabled_by_default": false,
  "rules": [
    {
      "id": "symbol-value-required",
      "name": "Symbol Value is present",
      "type": "required_field",
      "target": "symbol",
      "field": "Value",
      "severity": "warning",
      "save_behavior": "advisory"
    },
    {
      "id": "footprint-value-required",
      "name": "Footprint Value is present",
      "type": "required_field",
      "target": "footprint",
      "field": "Value",
      "severity": "warning",
      "save_behavior": "advisory"
    }
  ]
}
