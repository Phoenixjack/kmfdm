{
  "policy_schema_version": 1,
  "id": "datasheet-link-policy",
  "name": "Datasheet Link Policy",
  "description": "Suggested inspection-only checks for datasheet link fields.",
  "enabled_by_default": false,
  "rules": [
    {
      "id": "datasheet-url-shape",
      "name": "Datasheet resembles a URL or KiCad path",
      "type": "regex_check",
      "target": "both",
      "field": "Datasheet",
      "pattern": "^(https?://|\\$\\{[^}]+\\}/).+",
      "mode": "must_match",
      "ignore_blank": true,
      "severity": "warning",
      "save_behavior": "advisory"
    }
  ]
}
