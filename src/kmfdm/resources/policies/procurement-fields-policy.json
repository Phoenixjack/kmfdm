{
  "policy_schema_version": 1,
  "id": "procurement-fields-policy",
  "name": "Procurement Fields Policy",
  "description": "Suggested fields for supplier, purchase, and sourcing metadata.",
  "enabled_by_default": false,
  "rules": [
    {
      "id": "supplier-required",
      "name": "Supplier is present",
      "type": "required_field",
      "target": "symbol",
      "field": "Supplier",
      "severity": "info",
      "save_behavior": "advisory"
    },
    {
      "id": "supplier-url-aliases",
      "name": "Supplier URL aliases",
      "type": "alias_field_name",
      "target": "both",
      "canonical": "Supplier URL",
      "aliases": ["Purchase Link", "Vendor Link", "Vendor Purchase Link"],
      "severity": "warning",
      "save_behavior": "advisory"
    }
  ]
}
