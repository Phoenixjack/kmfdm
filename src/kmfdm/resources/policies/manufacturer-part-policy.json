{
  "policy_schema_version": 1,
  "id": "manufacturer-part-policy",
  "name": "Manufacturer Part Policy",
  "description": "Suggested checks for manufacturer and manufacturer part-number metadata.",
  "enabled_by_default": false,
  "rules": [
    {
      "id": "manufacturer-required",
      "name": "Manufacturer is present",
      "type": "required_field",
      "target": "symbol",
      "field": "Manufacturer",
      "severity": "info",
      "save_behavior": "advisory"
    },
    {
      "id": "mpn-aliases",
      "name": "Manufacturer part-number aliases",
      "type": "alias_field_name",
      "target": "both",
      "canonical": "Manufacturer Part Number",
      "aliases": ["MPN", "Mfr Part Number", "Manufacturer PN"],
      "severity": "warning",
      "save_behavior": "advisory"
    },
    {
      "id": "mpn-character-shape",
      "name": "Manufacturer part number uses expected characters",
      "type": "regex_check",
      "target": "symbol",
      "field": "Manufacturer Part Number",
      "pattern": "^[A-Za-z0-9._/+()#-]+$",
      "mode": "must_match",
      "ignore_blank": true,
      "severity": "warning",
      "save_behavior": "advisory"
    }
  ]
}
